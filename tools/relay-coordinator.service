# Fleet /health aggregator + optional reconnect-permit socket.
#
# Primary job today: poll public-mirror `GET /v1/mirrors` and serve the
# aggregated fleet JSON + dashboard HTML on 127.0.0.1:8082. nginx proxies
# the public 80/443 `/` and `/health` to this address.
#
# The Unix-socket reconnect permit remains for any leftover relay clients
# but is unused by public-mirror (one process, no per-region permits).
[Unit]
Description=relay-coordinator /health aggregator (public-mirror)
After=network-online.target public-mirror.service
Wants=network-online.target

[Service]
Type=simple
User=relay
Group=relay
ExecStart=/srv/relay/spacetimedb-relay/target/release/relay-coordinator \
    --socket /run/relay/coordinator.sock \
    --max-concurrent 1 \
    --health-bind 127.0.0.1:8082 \
    --mirrors-url http://127.0.0.1:3000/v1/mirrors \
    --index-html /srv/relay/bitcraft-relay/www/index.html
RuntimeDirectory=relay
RuntimeDirectoryMode=0750
WorkingDirectory=/srv/relay/spacetimedb-relay
Environment="PATH=/srv/relay/.local/bin:/srv/relay/.cargo/bin:/usr/local/bin:/usr/bin:/bin"
Environment="RUST_LOG=relay_coordinator=info"
Restart=on-failure
RestartSec=5s
TimeoutStopSec=10s

[Install]
WantedBy=multi-user.target
